{
  "name": "dsh-sidebar-hub",
  "version": "0.1.7",
  "description": "DSH 侧边栏分类框架：把右侧栏起始页换成按功能分组的插件入口（官方 / 工作台 / 工具 / 游戏 / 其他，v0.8 起四组），可拖拽分组与设置页维护，配置存 DSH settings；官方终端/浏览器/Office 预览由官方内置接管，md(mermaid) 渲染器自研；v0.6 起 hub 自研内容类型全部移除，仅做入口编排。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "workbench",
    "categorized",
    "terminal",
    "git",
    "browser",
    "subagent",
    "diff",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "docs/",
    "src/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node test/client-wiring.smoke.mjs && node test/host-settings.smoke.mjs",
    "check": "pnpm build && pnpm typecheck && node --check dist/index.js && node --check dist/client.js && pnpm test",
    "pack": "pnpm build && npm pack"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "mermaid": "^11.16.1",
    "react-icons": "5.7.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
